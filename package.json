{
  "name": "raphael-desktop",
  "productName": "Raphael",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop meeting assistant for English and Tagalog conversations.",
  "main": "dist/main/main.js",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p desktop/renderer && tsc --noEmit -p desktop/main",
    "build": "npm run typecheck && vite build && tsc -p desktop/main",
    "start": "npm run build && electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.5.0",
    "typescript": "~5.9.3",
    "vite": "7.3.8"
  }
}
